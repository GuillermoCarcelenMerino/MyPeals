# --- Gradle ---
.gradle/
**/build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/**/build/

# --- Kotlin ---
.kotlin/

# --- Configuración local (rutas específicas de cada máquina) ---
local.properties

# --- Android Studio / IntelliJ ---
*.iml
.idea/caches/
.idea/libraries/
.idea/modules/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/deploymentTargetDropdown.xml
.idea/other.xml
.idea/migrations.xml
.idea/markdown-exclusions.xml

# --- Salidas de compilación y release ---
*.apk
*.aab
*.ap_
*.dex
*.dm
app/release/
output-metadata.json

# --- NDK / CMake ---
.externalNativeBuild/
.cxx/

# --- Capturas y logs ---
captures/
*.log
hs_err_pid*

# --- Firma (nunca subir claves) ---
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.pepk
keystore/
keystore.properties
# (keystore.properties.example sí se sube: es solo la plantilla)

# --- Google services ---
google-services.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Secretos y credenciales ---
.env
.env.*
*.secret
service-account*.json
play-store-credentials*.json

# --- Mapping de R8 y símbolos (se suben a Play, no al repositorio) ---
app/build/outputs/mapping/
mapping.txt

# --- Android Studio: archivos personales ---
.idea/shelf/
.idea/dictionaries/
.idea/caches/
.idea/copilot/
.idea/ChatHistory*
.idea/AndroidProjectSystem.xml.bak

# --- Herramientas de IA / asistentes locales ---
.claude/
.cursor/
.gemini/

# --- Volcados de memoria y temporales ---
*.hprof
*.orig
*.rej
*.swp
*.tmp
*~
